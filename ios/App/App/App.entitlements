<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Base entitlements — used for DEVICE builds.
	     The Private Cloud Compute entitlement lives in
	     AppSimulator.entitlements (sim-only) because personal-team
	     provisioning profiles cannot currently include
	     com.apple.developer.private-cloud-compute (iOS 27 beta).
	     When Apple opens that capability for this App ID, move it here and
	     remove the targetEnvironment(simulator) guards in AppleLLMPlugin. -->
</dict>
</plist>
